#!/bin/sh

# Use neovim for vim if present.
[ -x "$(command -v nvim)" ] && alias v="nvim" vimdiff="nvim -d"

# youtube-dl
alias \
	yt='yt-dlp --embed-thumbnail --embed-metadata --add-metadata -i' \
	yta='yt -x -f bestaudio/best -o "~/Música/dl-music/%(title)s.%(ext)s"' \
	ytp='yt -x -f bestaudio/best -o "~/Vídeos/Podcast/%(title)s.%(ext)s"' \
	ytn='yt --embed-thumbnail --embed-metadata -o "./%(title)s.%(ext)s"'

# Expand sudo/doas to work with aliases
alias sudo="sudo "
alias doas="doas "

# Verbosity and settings that you pretty much just always are going to want.
alias \
	cp="cp -iv" \
	mv="mv -iv" \
	rm="rm -vI" \
	mkd="mkdir -pv" \
	rmd="rmdir -v" \
	du="du -h" \
	rs="rsync -Pa" \
	fm="thunar > /dev/null 2>&1 &" \
	texwatch="latexmk -pdf -pvc" # better latex compiler

# ffmpeg commands
alias \
	ffmpeg="ffmpeg -hide_banner" \
	ffconvert='find -maxdepth 1 -mindepth 1 \
        -type f -name "*.mkv" -print \
        -exec sh -c '\''i="{}"; ffmpeg -i "$i" -c:v libx264 -crf 22 "${i%.mkv}".mp4'\'' \;'

alias \
	z="zathura > /dev/null 2>&1" \
	ka="killall" \
	g="git status" \
	gc="git commit -m" \
	gp="git push" \
	gb="git branch" \
	gch="git checkout" \
	dcu="docker compose up -d" \
	dcd="docker compose down -v" \
	i="nsxiv -q -a -t" \
	sdn="shutdown -h now" \
	df='df -lH ' \
	f="fastfetch" \
	h="htop" \
	tcopy="wl-copy --trim-newline" \
	pcopy="pwd | wl-copy --trim-newline" \
	dopdf="lowriter --headless --convert-to pdf " \
	src="source ~/.config/zsh/.zshrc && echo 'sourceado nwn!'"

# Comandos administrativos de Portage
alias \
	eupdate="doas emerge --ask --update --deep --changed-use @world" \
	eneeded="doas emerge --ask --noreplace" \
	eclean="doas emerge --ask --depclean" \
    edeps="emerge --pretend --depclean --verbose"

# tmux commands
alias \
	tn="tmux-sessionizer.sh" \
	tk="tmux kill-session"

alias \
	ls="ls -hN --color=auto --group-directories-first" \
	fclist="fc-list -f '%{file}\n'" \

for program in dir vdir grep fgrep egrep diff ip; do
    eval "alias $program='$program --color=auto'"
done

# Mpv
alias podcast="mpv --no-video"
alias serie="mpv list.m3u8 > /dev/null 2>&1"
